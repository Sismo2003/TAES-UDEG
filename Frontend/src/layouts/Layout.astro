---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Portal TAEV — Prepa 2 UDG',
  description = 'Registro de preferencias de Trayectorias de Aprendizaje Especializante y Vinculación (TAEV), Preparatoria 2 de la Universidad de Guadalajara.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
