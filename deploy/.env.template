# =============================================================================
#  deploy/.env — copia este archivo a deploy/.env en el servidor (chmod 600).
#  NUNCA se commitea (lo cubre el .gitignore raíz).
# =============================================================================

# ── Postgres ─────────────────────────────────────────────────────────────────
# Generar la contraseña con: openssl rand -hex 24
# (hex a propósito: sin caracteres que haya que escapar en una URL).
POSTGRES_USER=taev
POSTGRES_PASSWORD=
POSTGRES_DB=taev_udeg_prepa2

# ── Versiones desplegadas ────────────────────────────────────────────────────
# Las reescribe rollout.sh al terminar un deploy exitoso. Un reinicio del
# servidor levanta exactamente estas versiones.
TAEV_API_TAG=latest
TAEV_WEB_TAG=latest
TAEV_ADMIN_TAG=latest

# ── ghcr.io (opcional) ───────────────────────────────────────────────────────
# Si root ya tiene `docker login ghcr.io` hecho, se pueden dejar vacías.
# PAT classic con scope read:packages.
GHCR_USER=
GHCR_TOKEN=
