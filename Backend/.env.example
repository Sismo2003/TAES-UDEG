# =============================================================================
#  Backend/.env.example — copia a Backend/.env y rellena los valores.
#  El .env real NUNCA se commitea (lo cubre el .gitignore de la raíz).
# =============================================================================

# ── Entorno ──────────────────────────────────────────────────────────────────
# 'production' en el servidor, 'dev' en local.
NODE_ENV=dev
PORT=4000

# Orígenes permitidos por CORS, separados por coma. NUNCA '*'.
# En dev: el Frontend (Astro) corre en http://localhost:4321 y el Admin en http://localhost:4322.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# En local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres --name taev-db postgres:16
# En producción: el contenedor/servicio que aloje Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taev_udeg_prepa2
DB_USER=postgres
DB_PASSWORD=postgres
# Por si tu setup usa SSL (común en proveedores gestionados)
DB_SSL=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=combined   # combined | common | dev | short | tiny

# ── Auth del panel admin ─────────────────────────────────────────────────────
# MÍNIMO 32 caracteres en producción — el servidor no arranca si no lo cumple.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiame-por-un-secreto-largo-de-verdad-32-plus
JWT_EXPIRES_IN=8h

# ── Dominio TAEV ─────────────────────────────────────────────────────────────
# Longitud exacta del código de alumno UDEG. Estrictamente 9 dígitos.
# Si lo cambiás acá, hay que cambiar también el CHECK
# `semester_students_code_format` con una migración.
TAEV_STUDENT_CODE_LENGTH=9

# Defaults al CREAR un semestre. El valor real de un semestre ya creado vive en
# su fila (semesters.ranks_required / opens_at / closes_at): tocar el .env no
# altera un semestre existente.
TAEV_DEFAULT_RANKS_REQUIRED=3
TAEV_DEFAULT_WINDOW_MINUTES=15

# Namespace del advisory lock que serializa las corridas del allocator.
# Cambiarlo sólo si choca con otro lock de la misma base.
TAEV_ALLOCATION_LOCK_KEY=728301

# Rate limit del portal público (por IP). El limiter global de app.js es más
# laxo; el envío del formulario necesita uno propio y estricto.
TAEV_SUBMIT_RATE_LIMIT_MAX=10
TAEV_SUBMIT_RATE_LIMIT_WINDOW_MS=60000
