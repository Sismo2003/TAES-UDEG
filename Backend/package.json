{
  "name": "backend-taev-udeg-prepa2",
  "version": "0.1.0",
  "description": "API REST para TAEV-UDEG-PREPA2",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"**/*.test.js\"",
    "prisma:generate": "node prisma/build-database-url.js generate",
    "prisma:pull": "node prisma/build-database-url.js db pull",
    "prisma:migrate:dev": "node prisma/build-database-url.js migrate dev",
    "prisma:migrate:deploy": "node prisma/build-database-url.js migrate deploy",
    "prisma:migrate:status": "node prisma/build-database-url.js migrate status",
    "prisma:studio": "node prisma/build-database-url.js studio",
    "prisma:format": "prisma format"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^6.1.0"
  }
